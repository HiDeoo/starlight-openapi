---
import type { ExamplesV3 } from '../../libs/example'
import type { Parameter } from '../../libs/parameter'
import ContentPicker from '../ContentPicker.astro'

import Example from './Example.astro'

export interface Props {
  example: unknown | undefined
  examples: ExamplesV3 | undefined
  generated?: boolean | undefined
  headingLevel: number
  parameter?: Parameter | undefined
  type?: string | undefined
}

const { example, examples, generated, headingLevel, parameter, type } = Astro.props

const level = Math.min(headingLevel, 6) as 1 | 2 | 3 | 4 | 5 | 6
const HeadingElement = `h${level}` as const
---

{example !== undefined || examples ? (
  examples ? (
    <div class="sl-openapi-examples">
      <HeadingElement class="sl-openapi-examples-heading">Examples</HeadingElement>
      <ContentPicker label="Select example" singleLabel="Example" types={Object.keys(examples)}>
        {Object.entries(examples).map(([exampleType, data], index) => <div
          data-openapi-content-type={exampleType}
          hidden={index > 0}
          role="tabpanel"
        >
          <Example example={data} {type} />
        </div>)}
      </ContentPicker>
    </div>
  ) : (
    <div class="sl-openapi-examples">
      <HeadingElement class="sl-openapi-examples-heading">
        Example
        {generated && <sup class="sl-openapi-examples-generated">generated</sup>}
      </HeadingElement>
      <Example raw={example} {parameter} {type} />
    </div>
  )
) : null}

<style>
  .sl-openapi-examples-heading {
    font-size: var(--sl-text-h5);
    margin-block: 0.8rem;
  }

  :global(.not-content) .sl-openapi-examples-heading {
    font-size: 0.83em;
  }

  .sl-openapi-examples-generated {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    margin-inline-start: 0.1875rem;
    position: relative;
    top: -0.125em;
  }
</style>
