---
import { getType } from '../../libs/items'
import { isArraySchemaType, type Properties, type SchemaObject } from '../../libs/schemaObject'
import Key from '../Key.astro'
import Tag from '../Tag.astro'
import Type from '../Type.astro'

import Schema, { type HideSchemaExampleProps } from './SchemaObject.astro'

interface Props extends HideSchemaExampleProps {
  parents: SchemaObject[]
  properties: Properties
  required: string[] | undefined
}

const { hideExample, parents, properties, required } = Astro.props

// sanitizeSchemaObjects() spreads parents into new objects, so clones share the same allOf array
// reference but fail strict === equality. Check allOf identity as a spread-equivalence fallback.
const sameSchema = (a: SchemaObject | undefined, b: SchemaObject | undefined) =>
  a !== undefined && b !== undefined && (a === b || (a.allOf !== undefined && a.allOf === b.allOf))
---

{
  Object.entries(properties).map(([name, schema]) => {
    const items = schema.items as SchemaObject | undefined
    const isRecursive = parents?.some(
      (parent) =>
        sameSchema(parent, schema) ||
        (isArraySchemaType(schema.type) &&
          (sameSchema(parent, items) ||
            items?.oneOf?.some((s: SchemaObject) => sameSchema(s, parent)) ||
            items?.anyOf?.some((s: SchemaObject) => sameSchema(s, parent)) ||
            items?.allOf?.some((s: SchemaObject) => sameSchema(s, parent)))),
    )

    return (
      <Key name={name} required={required?.includes(name)}>
        {isRecursive ? (
          <div>
            <Type>{getType(schema)}</Type>
            <Tag>recursive</Tag>
          </div>
        ) : (
          <Schema {hideExample} parents={parents} nested schemaObject={schema} />
        )}
      </Key>
    )
  })
}
